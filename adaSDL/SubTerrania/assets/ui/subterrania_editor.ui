<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.20"/>
  <object class="GtkWindow" id="main_window">
    <property name="title">SubTerrania Editor</property>
    <property name="default-width">1600</property>
    <property name="default-height">920</property>
    <property name="window-position">center</property>
    <signal name="destroy" handler="on_quit"/>
    <child><object class="GtkBox" id="root_box"><property name="orientation">vertical</property><property name="spacing">0</property><property name="margin">0</property><property name="hexpand">true</property><property name="vexpand">true</property><child><object class="GtkMenuBar" id="menu_bar">
<child><object class="GtkMenuItem"><property name="label">File</property>
<child type="submenu"><object class="GtkMenu"><child><object class="GtkMenuItem"><property name="label">New</property><signal name="activate" handler="on_new"/></object></child><child><object class="GtkMenuItem"><property name="label">Open Level</property><signal name="activate" handler="on_open"/></object></child><child><object class="GtkMenuItem"><property name="label">Save</property><signal name="activate" handler="on_save"/></object></child><child><object class="GtkMenuItem"><property name="label">Save As</property><signal name="activate" handler="on_save_as"/></object></child><child><object class="GtkMenuItem"><property name="label">Quit</property><signal name="activate" handler="on_quit"/></object></child></object></child>
</object></child>
<child><object class="GtkMenuItem"><property name="label">Edit</property>
<child type="submenu"><object class="GtkMenu"><child><object class="GtkMenuItem"><property name="label">Undo</property><signal name="activate" handler="on_undo"/></object></child><child><object class="GtkMenuItem"><property name="label">Redo</property><signal name="activate" handler="on_redo"/></object></child><child><object class="GtkMenuItem"><property name="label">Delete Selection</property><signal name="activate" handler="on_delete_selection"/></object></child></object></child>
</object></child>
<child><object class="GtkMenuItem"><property name="label">View</property>
<child type="submenu"><object class="GtkMenu"><child><object class="GtkMenuItem"><property name="label">Fullscreen</property><signal name="activate" handler="on_fullscreen"/></object></child><child><object class="GtkMenuItem"><property name="label">Fit Map</property><signal name="activate" handler="on_fit_map"/></object></child><child><object class="GtkCheckMenuItem" id="grid_menu_item"><property name="label">Show Grid</property><property name="active">true</property><signal name="toggled" handler="on_grid_menu_toggled"/></object></child></object></child>
</object></child>
<child><object class="GtkMenuItem"><property name="label">Project</property>
<child type="submenu"><object class="GtkMenu"><child><object class="GtkMenuItem"><property name="label">Validate</property><signal name="activate" handler="on_validate"/></object></child><child><object class="GtkMenuItem"><property name="label">Build Game</property><signal name="activate" handler="on_build_game"/></object></child><child><object class="GtkMenuItem"><property name="label">Playtest</property><signal name="activate" handler="on_playtest"/></object></child></object></child>
</object></child>
<child><object class="GtkMenuItem"><property name="label">Help</property>
<child type="submenu"><object class="GtkMenu"><child><object class="GtkMenuItem"><property name="label">Help</property><signal name="activate" handler="on_help"/></object></child><child><object class="GtkMenuItem"><property name="label">About</property><signal name="activate" handler="on_about"/></object></child></object></child>
</object></child>
</object></child><child><object class="GtkToolbar" id="toolbar"><property name="toolbar-style">icons</property>
<child><object class="GtkToolButton"><property name="label">New</property><property name="icon-name">document-new</property><property name="tooltip-text">New level</property><signal name="clicked" handler="on_new"/></object></child>
<child><object class="GtkToolButton"><property name="label">Open</property><property name="icon-name">document-open</property><property name="tooltip-text">Open level</property><signal name="clicked" handler="on_open"/></object></child>
<child><object class="GtkToolButton"><property name="label">Save</property><property name="icon-name">document-save</property><property name="tooltip-text">Save level and editor data</property><signal name="clicked" handler="on_save"/></object></child>
<child><object class="GtkSeparatorToolItem"/></child>
<child><object class="GtkToggleToolButton" id="select_tool"><property name="label">Select</property><property name="icon-name">cursor-default</property><property name="tooltip-text">Select tiles or objects</property><property name="active">true</property><signal name="toggled" handler="on_tool_select"/></object></child>
<child><object class="GtkToggleToolButton" id="brush_tool"><property name="label">Brush</property><property name="icon-name">draw-brush</property><property name="tooltip-text">Paint selected palette item</property><signal name="toggled" handler="on_tool_brush"/></object></child>
<child><object class="GtkToggleToolButton" id="eraser_tool"><property name="label">Erase</property><property name="icon-name">edit-clear</property><property name="tooltip-text">Erase terrain/object under cursor</property><signal name="toggled" handler="on_tool_eraser"/></object></child>
<child><object class="GtkToggleToolButton" id="pan_tool"><property name="label">Pan</property><property name="icon-name">transform-move</property><property name="tooltip-text">Drag/pan around the map</property><signal name="toggled" handler="on_tool_pan"/></object></child>
<child><object class="GtkToggleToolButton" id="path_tool"><property name="label">Path</property><property name="icon-name">insert-link</property><property name="tooltip-text">Add motion nodes to selected object</property><signal name="toggled" handler="on_tool_path"/></object></child>
<child><object class="GtkSeparatorToolItem"/></child>
<child><object class="GtkToggleToolButton" id="grid_tool"><property name="label">Grid</property><property name="icon-name">view-grid-symbolic</property><property name="tooltip-text">Toggle map grid overlay</property><property name="active">true</property><signal name="toggled" handler="on_grid_toolbar_toggled"/></object></child>
<child><object class="GtkToolButton"><property name="label">Fit</property><property name="icon-name">zoom-fit-best</property><property name="tooltip-text">Fit map to viewport</property><signal name="clicked" handler="on_fit_map"/></object></child>
<child><object class="GtkToolButton"><property name="label">Playtest</property><property name="icon-name">media-playback-start</property><property name="tooltip-text">Save and run the game</property><signal name="clicked" handler="on_playtest"/></object></child>
<child><object class="GtkToolButton"><property name="label">Build</property><property name="icon-name">system-run</property><property name="tooltip-text">Build game</property><signal name="clicked" handler="on_build_game"/></object></child>
</object></child><child><object class="GtkBox" id="work_area"><property name="orientation">horizontal</property><property name="spacing">4</property><property name="margin">0</property><property name="hexpand">true</property><property name="vexpand">true</property><child><object class="GtkBox" id="left_panel"><property name="orientation">vertical</property><property name="spacing">4</property><property name="margin">6</property><property name="width-request">240</property><child><object class="GtkLabel"><property name="label">Project</property><property name="use-markup">true</property><property name="xalign">0</property></object></child><child><object class="GtkButton"><property name="label">🗺  Level</property><signal name="clicked" handler="on_open_level_document"/></object></child><child><object class="GtkButton"><property name="label">🚀  Player Ship</property><signal name="clicked" handler="on_open_player_document"/></object></child><child><object class="GtkButton"><property name="label">👾  Enemies</property><signal name="clicked" handler="on_open_enemy_document"/></object></child><child><object class="GtkButton"><property name="label">🐙  Bosses / Encounters</property><signal name="clicked" handler="on_open_boss_document"/></object></child><child><object class="GtkButton"><property name="label">⚡  Weapons</property><signal name="clicked" handler="on_open_weapon_document"/></object></child><child><object class="GtkButton"><property name="label">✚  Powerups</property><signal name="clicked" handler="on_open_powerup_document"/></object></child><child><object class="GtkButton"><property name="label">♫  Audio</property><signal name="clicked" handler="on_open_audio_document"/></object></child><child><object class="GtkButton"><property name="label">◆  Triggers / Objectives</property><signal name="clicked" handler="on_open_trigger_document"/></object></child><child><object class="GtkLabel"><property name="label">Palette</property><property name="use-markup">true</property><property name="xalign">0</property></object></child><child><object class="GtkLabel"><property name="label">Terrain</property><property name="xalign">0</property></object></child><child><object class="GtkButton"><property name="label">■  Wall</property><property name="tooltip-text">Paint collision wall tile</property><signal name="clicked" handler="on_palette_wall"/></object></child><child><object class="GtkButton"><property name="label">≈  Water</property><property name="tooltip-text">Paint water/gravity tile</property><signal name="clicked" handler="on_palette_water"/></object></child><child><object class="GtkButton"><property name="label">▣  Landing</property><property name="tooltip-text">Paint landing tile</property><signal name="clicked" handler="on_palette_landing"/></object></child><child><object class="GtkButton"><property name="label">S  Start/Base</property><property name="tooltip-text">Paint player start tile</property><signal name="clicked" handler="on_palette_start"/></object></child><child><object class="GtkButton"><property name="label">□  Space / Clear Tile</property><signal name="clicked" handler="on_palette_space"/></object></child><child><object class="GtkLabel"><property name="label">Entities</property><property name="xalign">0</property></object></child><child><object class="GtkButton"><property name="label">M  Miner</property><signal name="clicked" handler="on_palette_miner"/></object></child><child><object class="GtkButton"><property name="label">E  Enemy</property><signal name="clicked" handler="on_palette_enemy"/></object></child><child><object class="GtkButton"><property name="label">P  Platform</property><signal name="clicked" handler="on_palette_platform"/></object></child><child><object class="GtkButton"><property name="label">G  Gate</property><signal name="clicked" handler="on_palette_gate"/></object></child><child><object class="GtkButton"><property name="label">B  Boss Spawn</property><signal name="clicked" handler="on_palette_boss"/></object></child><child><object class="GtkLabel"><property name="label">Pickups</property><property name="xalign">0</property></object></child><child><object class="GtkButton"><property name="label">F  Fuel</property><signal name="clicked" handler="on_palette_fuel"/></object></child><child><object class="GtkButton"><property name="label">S  Shield</property><signal name="clicked" handler="on_palette_shield"/></object></child></object></child><child><object class="GtkBox" id="center_panel"><property name="orientation">vertical</property><property name="spacing">4</property><property name="margin">0</property><property name="hexpand">true</property><property name="vexpand">true</property><child><object class="GtkNotebook" id="document_notebook"><property name="hexpand">true</property><property name="vexpand">true</property>
<child><object class="GtkFrame" id="map_canvas_frame"><property name="label">Map Canvas</property><property name="hexpand">true</property><property name="vexpand">true</property></object></child><child type="tab"><object class="GtkLabel"><property name="label">Map</property></object></child>
<child><object class="GtkBox" id="player_page"><property name="orientation">vertical</property><property name="spacing">8</property><property name="margin">12</property><property name="hexpand">true</property><property name="vexpand">true</property><child><object class="GtkLabel"><property name="label">Player Ship Editor</property><property name="use-markup">true</property><property name="xalign">0</property></object></child><child><object class="GtkLabel"><property name="label">Defines the ship template, thrust/fuel/shield values, sprite, and player sounds.</property><property name="xalign">0</property><property name="wrap">true</property></object></child><child><object class="GtkLabel"><property name="label">Name</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="player_name_entry"><property name="text">RescueShip01</property></object></child><child><object class="GtkLabel"><property name="label">Sprite</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="player_sprite_entry"><property name="text">assets/images/sprites/ship01.png</property></object></child><child><object class="GtkButton"><property name="label">Browse Ship Sprite</property><signal name="clicked" handler="on_browse_player_sprite"/></object></child><child><object class="GtkLabel"><property name="label">Thrust</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="player_thrust_entry"><property name="text">260</property></object></child><child><object class="GtkLabel"><property name="label">Drag</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="player_drag_entry"><property name="text">0.96</property></object></child><child><object class="GtkLabel"><property name="label">Fuel Max</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="player_fuel_entry"><property name="text">100</property></object></child><child><object class="GtkLabel"><property name="label">Shield Max</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="player_shield_entry"><property name="text">100</property></object></child><child><object class="GtkLabel"><property name="label">Engine Thrust Sound</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="player_engine_sound_entry"><property name="text">assets/audio/sfx/ship/thrust.wav</property></object></child><child><object class="GtkLabel"><property name="label">Shield Hit Sound</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="player_shield_hit_entry"><property name="text">assets/audio/sfx/shields/hit.wav</property></object></child><child><object class="GtkLabel"><property name="label">Shield Low Sound</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="player_shield_low_entry"><property name="text">assets/audio/sfx/shields/low.wav</property></object></child><child><object class="GtkButton"><property name="label">Browse Player Sound</property><signal name="clicked" handler="on_browse_player_sound"/></object></child></object></child><child type="tab"><object class="GtkLabel"><property name="label">Player</property></object></child><child><object class="GtkBox" id="enemy_page"><property name="orientation">vertical</property><property name="spacing">8</property><property name="margin">12</property><property name="hexpand">true</property><property name="vexpand">true</property><child><object class="GtkLabel"><property name="label">Enemy Template Editor</property><property name="use-markup">true</property><property name="xalign">0</property></object></child><child><object class="GtkLabel"><property name="label">Define reusable enemy behavior: animation, movement/path, weapon rule, fire arc, and detection.</property><property name="xalign">0</property><property name="wrap">true</property></object></child><child><object class="GtkLabel"><property name="label">Name</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="enemy_name_entry"><property name="text">Enemy_Scout</property></object></child><child><object class="GtkLabel"><property name="label">Health</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="enemy_health_entry"><property name="text">50</property></object></child><child><object class="GtkLabel"><property name="label">Fire Rate Seconds</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="enemy_fire_rate_entry"><property name="text">1.50</property></object></child><child><object class="GtkLabel"><property name="label">Planned fields: animation set, flying/walking mode, fire arc, weapon, detection range.</property><property name="xalign">0</property><property name="wrap">true</property></object></child></object></child><child type="tab"><object class="GtkLabel"><property name="label">Enemies</property></object></child><child><object class="GtkBox" id="boss_page"><property name="orientation">vertical</property><property name="spacing">8</property><property name="margin">12</property><property name="hexpand">true</property><property name="vexpand">true</property><child><object class="GtkLabel"><property name="label">Boss / Encounter Editor</property><property name="use-markup">true</property><property name="xalign">0</property></object></child><child><object class="GtkLabel"><property name="label">Bosses are enemy templates plus phases, body-part animations, movement paths, attacks, and music.</property><property name="xalign">0</property><property name="wrap">true</property></object></child><child><object class="GtkLabel"><property name="label">Name</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="boss_name_entry"><property name="text">Boss_01</property></object></child><child><object class="GtkLabel"><property name="label">Max HP</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="boss_hp_entry"><property name="text">300</property></object></child><child><object class="GtkLabel"><property name="label">Spawn Trigger</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="boss_trigger_entry"><property name="text">Boss_Zone</property></object></child><child><object class="GtkLabel"><property name="label">Music</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="boss_music_entry"><property name="text">assets/audio/music/boss01.mp3</property></object></child><child><object class="GtkButton"><property name="label">Browse Boss Music</property><signal name="clicked" handler="on_browse_boss_music"/></object></child><child><object class="GtkLabel"><property name="label">Phase 1 Condition</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="boss_phase1_hp_entry"><property name="text">HP_ABOVE 200</property></object></child><child><object class="GtkLabel"><property name="label">Phase 1 Path</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="boss_phase1_path_entry"><property name="text">Boss_01_Phase1</property></object></child><child><object class="GtkLabel"><property name="label">Phase 2 Condition</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="boss_phase2_hp_entry"><property name="text">HP_BELOW 200</property></object></child><child><object class="GtkLabel"><property name="label">Phase 2 Path</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="boss_phase2_path_entry"><property name="text">Boss_01_Phase2</property></object></child><child><object class="GtkLabel"><property name="label">Phase 3 Condition</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="boss_phase3_hp_entry"><property name="text">HP_BELOW 80</property></object></child><child><object class="GtkLabel"><property name="label">Phase 3 Path</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="boss_phase3_path_entry"><property name="text">Boss_01_Phase3</property></object></child><child><object class="GtkLabel"><property name="label">Animations</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="boss_normal_animation_entry"><property name="text">normal</property></object></child><child><object class="GtkEntry" id="boss_damaged_animation_entry"><property name="text">damaged</property></object></child><child><object class="GtkEntry" id="boss_critical_animation_entry"><property name="text">critical</property></object></child><child><object class="GtkEntry" id="boss_death_animation_entry"><property name="text">death</property></object></child></object></child><child type="tab"><object class="GtkLabel"><property name="label">Bosses</property></object></child><child><object class="GtkBox" id="weapon_page"><property name="orientation">vertical</property><property name="spacing">8</property><property name="margin">12</property><property name="hexpand">true</property><property name="vexpand">true</property><child><object class="GtkLabel"><property name="label">Weapon Editor</property><property name="use-markup">true</property><property name="xalign">0</property></object></child><child><object class="GtkLabel"><property name="label">Define red/blue/green lasers, missiles, Mega Shot, tube bombs, mirror laser, and projectile sounds.</property><property name="xalign">0</property><property name="wrap">true</property></object></child><child><object class="GtkLabel"><property name="label">Name</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="weapon_name_entry"><property name="text">Red_Laser</property></object></child><child><object class="GtkLabel"><property name="label">Damage</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="weapon_damage_entry"><property name="text">10</property></object></child><child><object class="GtkLabel"><property name="label">Cooldown</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="weapon_cooldown_entry"><property name="text">0.25</property></object></child><child><object class="GtkLabel"><property name="label">Projectile Speed</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="weapon_speed_entry"><property name="text">400</property></object></child><child><object class="GtkLabel"><property name="label">Charge States</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="weapon_charge_entry"><property name="text">none,charging,charged</property></object></child><child><object class="GtkLabel"><property name="label">Fire Sound</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="weapon_fire_sound_entry"><property name="text">assets/audio/sfx/weapons/laser_fire.wav</property></object></child><child><object class="GtkLabel"><property name="label">Hit Sound</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="weapon_hit_sound_entry"><property name="text">assets/audio/sfx/weapons/laser_hit.wav</property></object></child><child><object class="GtkLabel"><property name="label">Charge Sound</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="weapon_charge_sound_entry"><property name="text">assets/audio/sfx/weapons/laser_charge.wav</property></object></child></object></child><child type="tab"><object class="GtkLabel"><property name="label">Weapons</property></object></child><child><object class="GtkBox" id="powerup_page"><property name="orientation">vertical</property><property name="spacing">8</property><property name="margin">12</property><property name="hexpand">true</property><property name="vexpand">true</property><child><object class="GtkLabel"><property name="label">Powerup Editor</property><property name="use-markup">true</property><property name="xalign">0</property></object></child><child><object class="GtkLabel"><property name="label">Items can glow, be collected, switch to a used state, and apply a defined effect.</property><property name="xalign">0</property><property name="wrap">true</property></object></child><child><object class="GtkLabel"><property name="label">Name</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="powerup_name_entry"><property name="text">Shield_Recharge</property></object></child><child><object class="GtkLabel"><property name="label">Value</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="powerup_value_entry"><property name="text">25</property></object></child><child><object class="GtkLabel"><property name="label">Duration</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="powerup_duration_entry"><property name="text">0</property></object></child><child><object class="GtkLabel"><property name="label">Pickup Sound</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="powerup_sound_entry"><property name="text">assets/audio/sfx/pickups/shield.wav</property></object></child></object></child><child type="tab"><object class="GtkLabel"><property name="label">Powerups</property></object></child><child><object class="GtkBox" id="audio_page"><property name="orientation">vertical</property><property name="spacing">8</property><property name="margin">12</property><property name="hexpand">true</property><property name="vexpand">true</property><child><object class="GtkLabel"><property name="label">Audio Assignment Editor</property><property name="use-markup">true</property><property name="xalign">0</property></object></child><child><object class="GtkLabel"><property name="label">Assign local music/sfx paths. Audio files remain ignored by Git.</property><property name="xalign">0</property><property name="wrap">true</property></object></child><child><object class="GtkLabel"><property name="label">Main Menu Music</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="menu_music_entry"><property name="text">assets/audio/music/menu_carousel.mp3</property></object></child><child><object class="GtkButton"><property name="label">Browse Menu Music</property><signal name="clicked" handler="on_browse_menu_music"/></object></child><child><object class="GtkLabel"><property name="label">Level Music</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="music_entry"><property name="text">assets/audio/music/mission01.ogg</property></object></child><child><object class="GtkEntry" id="level_music_entry"><property name="text">assets/audio/music/mission01.ogg</property></object></child><child><object class="GtkButton"><property name="label">Browse Level Music</property><signal name="clicked" handler="on_browse_level_music"/></object></child><child><object class="GtkLabel"><property name="label">Boss Music</property><property name="xalign">0</property></object></child><child><object class="GtkEntry" id="audio_boss_music_entry"><property name="text">assets/audio/music/boss01.ogg</property></object></child><child><object class="GtkButton"><property name="label">Browse Boss Music</property><signal name="clicked" handler="on_browse_audio_boss_music"/></object></child></object></child><child type="tab"><object class="GtkLabel"><property name="label">Audio