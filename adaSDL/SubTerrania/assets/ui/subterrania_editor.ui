<?xml version='1.0' encoding='utf-8'?>
<interface>
  <requires lib="gtk+" version="3.20" />
  <object class="GtkWindow" id="main_window">
    <property name="title">SubTerrania Editor</property>
    <property name="default-width">1500</property>
    <property name="default-height">900</property>
    <property name="window-position">center</property>
    <property name="icon-name">applications-graphics</property>
    <signal name="destroy" handler="on_quit" />
    <child>
      <object class="GtkBox" id="root_box">
        <property name="orientation">vertical</property>
        <property name="spacing">0</property>
        <property name="hexpand">true</property>
        <property name="vexpand">true</property>
        <child>
          <object class="GtkMenuBar" id="menu_bar">
            <child>
              <object class="GtkMenuItem">
                <property name="label">File</property>
                <child type="submenu">
                  <object class="GtkMenu">
                    <child>
                      <object class="GtkMenuItem">
                        <property name="label">New Level</property>
                        <signal name="activate" handler="on_new" />
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem">
                        <property name="label">Open Level</property>
                        <signal name="activate" handler="on_open" />
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem">
                        <property name="label">Save</property>
                        <signal name="activate" handler="on_save" />
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem">
                        <property name="label">Save As</property>
                        <signal name="activate" handler="on_save_as" />
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem">
                        <property name="label">Quit</property>
                        <signal name="activate" handler="on_quit" />
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkMenuItem">
                <property name="label">Edit</property>
                <child type="submenu">
                  <object class="GtkMenu">
                    <child>
                      <object class="GtkMenuItem">
                        <property name="label">Undo</property>
                        <signal name="activate" handler="on_undo" />
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem">
                        <property name="label">Redo</property>
                        <signal name="activate" handler="on_redo" />
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem">
                        <property name="label">Delete Selection</property>
                        <signal name="activate" handler="on_delete" />
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem">
                        <property name="label">Object Properties</property>
                        <signal name="activate" handler="on_object_properties" />
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkMenuItem">
                <property name="label">Mode</property>
                <child type="submenu">
                  <object class="GtkMenu">
                    <child>
                      <object class="GtkMenuItem">
                        <property name="label">Map</property>
                        <signal name="activate" handler="on_mode_map" />
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem">
                        <property name="label">Object</property>
                        <signal name="activate" handler="on_mode_object" />
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem">
                        <property name="label">Path</property>
                        <signal name="activate" handler="on_mode_path" />
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem">
                        <property name="label">Trigger</property>
                        <signal name="activate" handler="on_mode_trigger" />
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkMenuItem">
                <property name="label">Draw</property>
                <child type="submenu">
                  <object class="GtkMenu">
                    <child>
                      <object class="GtkMenuItem">
                        <property name="label">Select</property>
                        <signal name="activate" handler="on_tool_select" />
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem">
                        <property name="label">Pencil</property>
                        <signal name="activate" handler="on_tool_brush" />
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem">
                        <property name="label">Erase</property>
                        <signal name="activate" handler="on_tool_erase" />
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem">
                        <property name="label">Pan</property>
                        <signal name="activate" handler="on_tool_pan" />
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkMenuItem">
                <property name="label">Scale</property>
                <child type="submenu">
                  <object class="GtkMenu">
                    <child>
                      <object class="GtkMenuItem">
                        <property name="label">Zoom In</property>
                        <signal name="activate" handler="on_zoom_in" />
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem">
                        <property name="label">Zoom Out</property>
                        <signal name="activate" handler="on_zoom_out" />
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem">
                        <property name="label">Fit Map</property>
                        <signal name="activate" handler="on_fit" />
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem">
                        <property name="label">Center on Start</property>
                        <signal name="activate" handler="on_home" />
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckMenuItem" id="grid_menu_item">
                        <property name="label">Show Grid</property>
                        <property name="active">true</property>
                        <signal name="toggled" handler="on_grid_menu" />
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkMenuItem">
                <property name="label">Tools</property>
                <child type="submenu">
                  <object class="GtkMenu">
                    <child>
                      <object class="GtkMenuItem">
                        <property name="label">Database</property>
                        <signal name="activate" handler="on_database" />
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem">
                        <property name="label">Level Properties</property>
                        <signal name="activate" handler="on_level_properties" />
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem">
                        <property name="label">Validate Level</property>
                        <signal name="activate" handler="on_validate" />
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkMenuItem">
                <property name="label">Game</property>
                <child type="submenu">
                  <object class="GtkMenu">
                    <child>
                      <object class="GtkMenuItem">
                        <property name="label">Playtest</property>
                        <signal name="activate" handler="on_playtest" />
                      </object>
                    </child>
                    <child>
                      <object class="GtkMenuItem">
                        <property name="label">Build Game</property>
                        <signal name="activate" handler="on_build" />
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkMenuItem">
                <property name="label">Help</property>
                <child type="submenu">
                  <object class="GtkMenu">
                    <child>
                      <object class="GtkMenuItem">
                        <property name="label">Editor Help</property>
                        <signal name="activate" handler="on_help" />
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkToolbar" id="toolbar">
            <property name="toolbar-style">icons</property>
            <property name="icon-size">large-toolbar</property>
            <child>
              <object class="GtkToolButton">
                <property name="label">New</property>
                <property name="icon-name">document-new</property>
                <property name="tooltip-text">New level</property>
                <signal name="clicked" handler="on_new" />
              </object>
            </child>
            <child>
              <object class="GtkToolButton">
                <property name="label">Open</property>
                <property name="icon-name">document-open</property>
                <property name="tooltip-text">Open level</property>
                <signal name="clicked" handler="on_open" />
              </object>
            </child>
            <child>
              <object class="GtkToolButton">
                <property name="label">Save</property>
                <property name="icon-name">document-save</property>
                <property name="tooltip-text">Save level</property>
                <signal name="clicked" handler="on_save" />
              </object>
            </child>
            <child>
              <object class="GtkSeparatorToolItem" />
            </child>
            <child>
              <object class="GtkToolButton">
                <property name="label">Undo</property>
                <property name="icon-name">edit-undo</property>
                <property name="tooltip-text">Undo</property>
                <signal name="clicked" handler="on_undo" />
              </object>
            </child>
            <child>
              <object class="GtkToolButton">
                <property name="label">Redo</property>
                <property name="icon-name">edit-redo</property>
                <property name="tooltip-text">Redo</property>
                <signal name="clicked" handler="on_redo" />
              </object>
            </child>
            <child>
              <object class="GtkSeparatorToolItem" />
            </child>
            <child>
              <object class="GtkToggleToolButton" id="mode_map_tool">
                <property name="label">Map</property>
                <property name="icon-name">applications-graphics</property>
                <property name="active">true</property>
                <property name="tooltip-text">Map editing mode</property>
                <signal name="toggled" handler="on_mode_map" />
              </object>
            </child>
            <child>
              <object class="GtkToggleToolButton" id="mode_object_tool">
                <property name="label">Object</property>
                <property name="icon-name">insert-object</property>
                <property name="tooltip-text">Object placement and selection</property>
                <signal name="toggled" handler="on_mode_object" />
              </object>
            </child>
            <child>
              <object class="GtkToggleToolButton" id="mode_path_tool">
                <property name="label">Path</property>
                <property name="icon-name">draw-line</property>
                <property name="tooltip-text">Edit selected object path</property>
                <signal name="toggled" handler="on_mode_path" />
              </object>
            </child>
            <child>
              <object class="GtkToggleToolButton" id="mode_trigger_tool">
                <property name="label">Trigger</property>
                <property name="icon-name">system-run</property>
                <property name="tooltip-text">Trigger and objective zones</property>
                <signal name="toggled" handler="on_mode_trigger" />
              </object>
            </child>
            <child>
              <object class="GtkSeparatorToolItem" />
            </child>
            <child>
              <object class="GtkToggleToolButton" id="select_tool">
                <property name="label">Select</property>
                <property name="icon-name">cursor-default</property>
                <property name="active">true</property>
                <property name="tooltip-text">Select an item</property>
                <signal name="toggled" handler="on_tool_select" />
              </object>
            </child>
            <child>
              <object class="GtkToggleToolButton" id="brush_tool">
                <property name="label">Pencil</property>
                <property name="icon-name">draw-freehand</property>
                <property name="tooltip-text">Paint/place selected palette item</property>
                <signal name="toggled" handler="on_tool_brush" />
              </object>
            </child>
            <child>
              <object class="GtkToggleToolButton" id="eraser_tool">
                <property name="label">Erase</property>
                <property name="icon-name">edit-clear</property>
                <property name="tooltip-text">Erase at cursor</property>
                <signal name="toggled" handler="on_tool_erase" />
              </object>
            </child>
            <child>
              <object class="GtkToggleToolButton" id="pan_tool">
                <property name="label">Pan</property>
                <property name="icon-name">transform-move</property>
                <property name="tooltip-text">Left-drag to pan; middle-drag always pans</property>
                <signal name="toggled" handler="on_tool_pan" />
              </object>
            </child>
            <child>
              <object class="GtkSeparatorToolItem" />
            </child>
            <child>
              <object class="GtkToolButton">
                <property name="label">Zoom In</property>
                <property name="icon-name">zoom-in</property>
                <property name="tooltip-text">Zoom in</property>
                <signal name="clicked" handler="on_zoom_in" />
              </object>
            </child>
            <child>
              <object class="GtkToolButton">
                <property name="label">Zoom Out</property>
                <property name="icon-name">zoom-out</property>
                <property name="tooltip-text">Zoom out</property>
                <signal name="clicked" handler="on_zoom_out" />
              </object>
            </child>
            <child>
              <object class="GtkToolButton">
                <property name="label">Fit</property>
                <property name="icon-name">zoom-fit-best</property>
                <property name="tooltip-text">Fit whole map</property>
                <signal name="clicked" handler="on_fit" />
              </object>
            </child>
            <child>
              <object class="GtkToolButton">
                <property name="label">Home</property>
                <property name="icon-name">go-home</property>
                <property name="tooltip-text">Center on player start</property>
                <signal name="clicked" handler="on_home" />
              </object>
            </child>
            <child>
              <object class="GtkToggleToolButton" id="grid_tool">
                <property name="label">Grid</property>
                <property name="icon-name">view-grid</property>
                <property name="active">true</property>
                <property name="tooltip-text">Toggle grid</property>
                <signal name="toggled" handler="on_grid" />
              </object>
            </child>
            <child>
              <object class="GtkSeparatorToolItem" />
            </child>
            <child>
              <object class="GtkToolButton">
                <property name="label">Database</property>
                <property name="icon-name">preferences-system</property>
                <property name="tooltip-text">Open game database</property>
                <signal name="clicked" handler="on_database" />
              </object>
            </child>
            <child>
              <object class="GtkToolButton">
                <property name="label">Object</property>
                <property name="icon-name">document-properties</property>
                <property name="tooltip-text">Edit selected object</property>
                <signal name="clicked" handler="on_object_properties" />
              </object>
            </child>
            <child>
              <object class="GtkToolButton">
                <property name="label">Level</property>
                <property name="icon-name">emblem-system</property>
                <property name="tooltip-text">Level properties</property>
                <signal name="clicked" handler="on_level_properties" />
              </object>
            </child>
            <child>
              <object class="GtkToolButton">
                <property name="label">Playtest</property>
                <property name="icon-name">media-playback-start</property>
                <property name="tooltip-text">Save and run game</property>
                <signal name="clicked" handler="on_playtest" />
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkPaned" id="main_paned">
            <property name="orientation">horizontal</property>
            <property name="position">300</property>
            <property name="wide-handle">true</property>
            <property name="hexpand">true</property>
            <property name="vexpand">true</property>
            <child>
              <object class="GtkBox" id="left_sidebar">
                <property name="orientation">vertical</property>
                <property name="spacing">4</property>
                <property name="width-request">280</property>
                <property name="vexpand">true</property>
                <child>
                  <object class="GtkPaned" id="left_paned">
                    <property name="orientation">vertical</property>
                    <property name="position">470</property>
                    <property name="wide-handle">true</property>
                    <property name="vexpand">true</property>
                    <child>
                      <object class="GtkNotebook" id="palette_notebook">
                        <property name="vexpand">true</property>
                        <child>
                          <object class="GtkScrolledWindow">
                            <property name="hscrollbar-policy">never</property>
                            <property name="vexpand">true</property>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">5</property>
                                <property name="margin">6</property>
                                <child>
                                  <object class="GtkButton">
                                    <property name="label">Wall</property>
                                    <signal name="clicked" handler="on_palette_wall" />
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton">
                                    <property name="label">Water</property>
                                    <signal name="clicked" handler="on_palette_water" />
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton">
                                    <property name="label">Landing Pad</property>
                                    <signal name="clicked" handler="on_palette_landing" />
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton">
                                    <property name="label">Start / Base</property>
                                    <signal name="clicked" handler="on_palette_start" />
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton">
                                    <property name="label">Clear Tile</property>
                                    <signal name="clicked" handler="on_palette_space" />
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child type="tab">
                          <object class="GtkLabel">
                            <property name="label">Tiles</property>
                            <property name="xalign">0.5</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkScrolledWindow">
                            <property name="hscrollbar-policy">never</property>
                            <property name="vexpand">true</property>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">5</property>
                                <property name="margin">6</property>
                                <child>
                                  <object class="GtkButton">
                                    <property name="label">Miner</property>
                                    <signal name="clicked" handler="on_palette_miner" />
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton">
                                    <property name="label">Enemy</property>
                                    <signal name="clicked" handler="on_palette_enemy" />
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton">
                                    <property name="label">Moving Platform</property>
                                    <signal name="clicked" handler="on_palette_platform" />
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton">
                                    <property name="label">Gate / Base</property>
                                    <signal name="clicked" handler="on_palette_gate" />
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton">
                                    <property name="label">Boss Spawn</property>
                                    <signal name="clicked" handler="on_palette_boss" />
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton">
                                    <property name="label">Fuel Pickup</property>
                                    <signal name="clicked" handler="on_palette_fuel" />
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton">
                                    <property name="label">Shield Pickup</property>
                                    <signal name="clicked" handler="on_palette_shield" />
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton">
                                    <property name="label">Generic Powerup</property>
                                    <signal name="clicked" handler="on_palette_powerup" />
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child type="tab">
                          <object class="GtkLabel">
                            <property name="label">Objects</property>
                            <property name="xalign">0.5</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkScrolledWindow">
                            <property name="hscrollbar-policy">never</property>
                            <property name="vexpand">true</property>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">4</property>
                                <property name="margin">8</property>
                                <child>
                                  <object class="GtkCheckButton" id="layer_background">
                                    <property name="label">Background</property>
                                    <property name="active">true</property>
                                    <signal name="toggled" handler="on_layer_background" />
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkCheckButton" id="layer_terrain">
                                    <property name="label">Terrain / Collision</property>
                                    <property name="active">true</property>
                                    <signal name="toggled" handler="on_layer_terrain" />
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkCheckButton" id="layer_water">
                                    <property name="label">Water</property>
                                    <property name="active">true</property>
                                    <signal name="toggled" handler="on_layer_water" />
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkCheckButton" id="layer_pickups">
                                    <property name="label">Pickups</property>
                                    <property name="active">true</property>
                                    <signal name="toggled" handler="on_layer_pickups" />
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkCheckButton" id="layer_destructibles">
                                    <property name="label">Destructibles</property>
                                    <property name="active">true</property>
                                    <signal name="toggled" handler="on_layer_destructibles" />
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkCheckButton" id="layer_platforms">
                                    <property name="label">Platforms</property>
                                    <property name="active">true</property>
                                    <signal name="toggled" handler="on_layer_platforms" />
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkCheckButton" id="layer_miners">
                                    <property name="label">Miners</property>
                                    <property name="active">true</property>
                                    <signal name="toggled" handler="on_layer_miners" />
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkCheckButton" id="layer_enemies">
                                    <property name="label">Enemies / Bosses</property>
                                    <property name="active">true</property>
                                    <signal name="toggled" handler="on_layer_enemies" />
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkCheckButton" id="layer_triggers">
                                    <property name="label">Triggers / Bases</property>
                                    <property name="active">true</property>
                                    <signal name="toggled" handler="on_layer_triggers" />
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkCheckButton" id="layer_paths">
                                    <property name="label">Paths / Debug</property>
                                    <property name="active">true</property>
                                    <signal name="toggled" handler="on_layer_paths" />
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">Layers control visibility. Draw order is fixed for Phase 13.</property>
                                    <property name="xalign">0</property>
                                    <property name="wrap">true</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child type="tab">
                          <object class="GtkLabel">
                            <property name="label">Layers</property>
                            <property name="xalign">0.5</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">never</property>
                        <property name="vexpand">true</property>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">3</property>
                            <property name="margin">6</property>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Project</property>
                                <property name="xalign">0</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Levels</property>
                                <property name="xalign">0</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton">
                                <property name="label">    Stage01</property>
                                <signal name="clicked" handler="on_open_stage01" />
                              </object>
                            </child>
                            <child>
                              <object class="GtkSeparator" />
